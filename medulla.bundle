      batch.signature = this.tree.signature // same sig

      const entry = {
        userData: null,
        treeNodes: batch.nodes,
        treeUpgrade: batch,
        bitfield: {
          drop: true,
          start: batch.ancestors,
          length: len - batch.ancestors
