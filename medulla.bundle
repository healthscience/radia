  for (let i = 0; i < names.length; i++) {
    if (names[i] === '') continue
    if (names[i] === '.') continue
    if (names[i] === '..') {
      if (p.length === 1) throw new Error('Path cannot be resolved, too many \'..\'')
      p = p.slice(0, p.lastIndexOf('/')) || '/'
      continue
    }
    p += (p.length === 1 ? names[i] : '/' + names[i])
  }

  return p
}

