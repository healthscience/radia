const rabin = require('rabin-native')

module.exports = class RabinStream extends Transform {
  constructor(opts = {}) {
    super()

    this._rabin = new rabin.Chunker(opts)
    this._buffer = []
  }

  _transform(data, cb) {
    if (typeof data === 'string') data = Buffer.from(data)

    this._buffer.push(data)

    const chunks = this._rabin.push(data)

    for (const chunk of chunks) {
      let data = this._buffer[0]

      if (data.byteLength < chunk.length) {
        data = Buffer.concat(this._buffer)

        this._buffer = []
      } else {
        this._buffer.pop()
      }

      this.push(data.subarray(0, chunk.length))

      data = data.subarray(chunk.length)

      if (data.byteLength) this._buffer.unshift(data)
    }

    cb(null)
  }

  _flush(cb) {
    if (this._buffer.length) {
      this.push(Buffer.concat(this._buffer))
    }

    this._buffer = []

    cb(null)
  }
}
{
  "name": "rabin-stream",
  "version": "2.0.0",
  "description": "Streaming Rabin chunker",
  "exports": {
    "./package": "./package.json",
    ".": "./index.js"
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "files": [
    "index.js"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:node && npm run test:bare",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
