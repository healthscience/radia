    for (const prefix of this.prefix) {
      if (this.entries) {
        lists.push(this.entries)
      } else {
        const stream = a.list(prefix, { ignore: this.ignore })
        if (stream.on) {
          stream.on('error', noop)
          stream.resume()
          stream.pause()
