        opts = offset
        offset = 0
        length = arrayBuffer.byteLength
      } else if (typeof length === 'object' && length !== null) {
        opts = length
        length = arrayBuffer.byteLength - offset
      }
    }

    super(arrayBuffer, offset, length)
  }

  get [kind]() {
    return Buffer[kind]
  }

